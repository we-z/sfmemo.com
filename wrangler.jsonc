{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "sfmemo-com",
  "main": "worker/index.js",
  "compatibility_date": "2026-08-29",
  "workers_dev": true,
  "routes": [
    {
      "pattern": "sfmemo.com",
      "custom_domain": true
    },
    {
      "pattern": "www.sfmemo.com",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "html_handling": "none",
    "run_worker_first": true
  }
}
